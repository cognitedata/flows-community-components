{
  "name": "aura",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --clean && tsc -b && vite build && cp dist/index.html dist/404.html",
    "start": "tsc -b && vite build && vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook",
    "storybook:test": "pnpm run test:storybook",
    "storybook:test:components": "pnpm run test:storybook",
    "storybook:test:ai-elements": "pnpm run test:storybook",
    "storybook:test:components:ci": "pnpm run test:storybook:ci",
    "storybook:test:ai-elements:ci": "pnpm run test:storybook:ci",
    "test:storybook": "vitest --config .storybook/vitest.config.ts",
    "test:storybook:ci": "vitest --run --config .storybook/vitest.config.ts",
    "registry:build": "npx tsx scripts/build-registry.ts && npx shadcn@latest build",
    "registry:clean": "rm -f public/r/*.json"
  },
  "dependencies": {
    "@base-ui/react": "latest",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/vite": "^4.1.18",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.29.2",
    "motion": "^12.29.2",
    "nanoid": "^5.1.6",
    "ogl": "^1.0.11",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "3.7.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.21.0",
    "sonner": "^2.0.7",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^3.4.0",
    "tokenlens": "^1.3.1",
    "tsx": "^4.21.0",
    "use-stick-to-bottom": "^1.1.2",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.6",
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6",
    "@biomejs/biome": "^2.0.0",
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.2.5",
    "@storybook/addon-docs": "^10.2.5",
    "@storybook/addon-vitest": "^10.2.5",
    "@storybook/react": "^10.2.5",
    "@storybook/react-vite": "^10.2.5",
    "@storybook/test": "^8.6.15",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "playwright": "^1.58.1",
    "postcss": "^8.5.6",
    "storybook": "^10.2.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.3.1"
    },
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
