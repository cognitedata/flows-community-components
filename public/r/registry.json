        "@base-ui/react",
        "@cognite/aura"
      ],
      "files": [
        {
          "path": "src/components/ui/community/alert-dialog/alert-dialog.tsx",
          "target": "src/components/ui/community/alert-dialog.tsx",
          "type": "registry:component"
        }
      ]
    },
