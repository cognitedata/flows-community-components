{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "@aura",
  "homepage": "https://cognitedata.github.io/aura/",
  "items": [
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Theme",
      "description": "Theme component.",
      "files": [
        {
          "path": "src/styleScope.ts",
          "type": "registry:item"
        },
        {
          "path": "src/styleScope.d.ts",
          "type": "registry:item"
        }
      ]
    },
    {
      "name": "css",
      "type": "registry:component",
      "title": "CSS",
      "description": "Installs Aura global styles (import once in your app entrypoint).",
      "dependencies": ["tw-animate-css"],
      "files": [
        {
          "path": "src/globals.css",
          "target": "src/styles.css",
          "type": "registry:component"
        }
      ]
    }
  ]
}
